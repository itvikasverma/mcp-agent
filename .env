# ──────────────────────────────────────────────
#  .env.example  —  copy to .env and fill in
#  cp .env.example .env
# ──────────────────────────────────────────────

# ── LLM ───────────────────────────────────────
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Qdrant ────────────────────────────────────
# Local Docker default: http://localhost
# Qdrant Cloud: https://<cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_URL=http://localhost

# Optional — leave blank for a local unauthenticated Qdrant instance.
# Required if you are using Qdrant Cloud.
QDRANT_API_KEY=

# Name of the Qdrant collection used to store document chunks.
QDRANT_COLLECTION_NAME=repay_docs

# ── Embedding model ───────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Service ports ─────────────────────────────
API_PORT=9000
WEB_PORT=8000

# ── Document sources ──────────────────────────
DATA_STORE_PATH=data/store

# ── Optional: AWS S3 ──────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=

# ── Optional: Confluence ──────────────────────
CONFLUENCE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_USERNAME=your_email@example.com
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=